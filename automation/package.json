{
  "name": "automation",
  "version": "1.0.0",
  "description": "This directory contains all automation testing configurations and tools for the Suliit Flutter application.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "appium": "appium --relaxed-security --session-override --log logs/appium.log",
    "appium:start": "appium --relaxed-security --session-override --log logs/appium.log &",
    "appium:stop": "pkill -f appium || true",
    "appium:doctor": "appium-doctor --android --ios",
    "appium:version": "appium --version",
    "drivers:list": "appium driver list",
    "drivers:install": "appium driver install uiautomator2 && appium driver install xcuitest",
    "test:flutter": "cd .. && flutter drive --target=automation/tests/test_driver/app.dart",
    "setup": "npm run drivers:install && npm run appium:doctor",
    "start": "npm run appium:start",
    "stop": "npm run appium:stop",
    "status": "curl -s http://127.0.0.1:4723/wd/hub/status || echo 'Appium server not running'",
    "wdio": "wdio run ./wdio.conf.ts",
    "test:android": "wdio run ./wdio.android.conf.js",
    "test:ios": "wdio run ./wdio.ios.conf.js",
    "test:both": "npm run test:android && npm run test:ios",
    "report:android": "allure generate reports/allure-results/android/ --clean -o reports/allure-report/android/",
    "report:ios": "allure generate reports/allure-results/ios/ --clean -o reports/allure-report/ios/",
    "report:serve:android": "allure serve reports/allure-results/android/",
    "report:serve:ios": "allure serve reports/allure-results/ios/",
    "clean:reports": "rm -rf reports/allure-results/* reports/allure-report/* reports/junit/*",
    "clean:screenshots": "rm -rf screenshots/android/* screenshots/ios/*",
    "clean:all": "npm run clean:reports && npm run clean:screenshots"
  },
  "keywords": [
    "appium",
    "automation",
    "testing",
    "mobile",
    "flutter"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "."
  },
  "devDependencies": {
    "@appium/doctor": "^2.1.15",
    "@wdio/allure-reporter": "^9.19.2",
    "@wdio/appium-service": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/junit-reporter": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "@wdio/visual-service": "^9.0.0",
    "allure-commandline": "^2.34.1",
    "appium": "^2.11.2",
    "appium-base-driver": "^7.11.3",
    "appium-flutter-driver": "^2.19.0",
    "appium-flutter-finder": "^0.2.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "appium-xcuitest-driver": "^5.16.1",
    "chai": "^6.0.1",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.7.2",
    "wd": "^1.14.0",
    "webdriverio": "^9.19.2"
  }
}
